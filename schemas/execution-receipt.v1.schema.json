{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operationproof.dev/schemas/execution-receipt.v1.schema.json",
  "title": "OperationProof Execution Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider",
    "receipt_id",
    "operation_id",
    "pre_proof_digest",
    "status",
    "result_digest",
    "started_at",
    "completed_at",
    "receipt_digest"
  ],
  "properties": {
    "schema": {
      "const": "operationproof.execution-receipt.v1"
    },
    "provider": {
      "enum": ["sandcloud", "caser"]
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "pre_proof_digest": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "enum": ["SUCCEEDED", "FAILED", "CANCELLED", "UNKNOWN"]
    },
    "result_digest": {
      "$ref": "#/$defs/sha256"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "receipt_digest": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
