{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operationproof.dev/schemas/attestation-signature.v1.schema.json",
  "title": "OperationProof Attestation Signature v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "algorithm",
    "issuer_id",
    "key_id",
    "attestation_digest",
    "signature"
  ],
  "properties": {
    "schema": {"const": "operationproof.attestation-signature.v1"},
    "algorithm": {"type": "string", "minLength": 1, "maxLength": 512},
    "issuer_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "key_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "attestation_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,2048}$"
    }
  }
}
